# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3001/ws

# Backend
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Hours an update is kept after a snapshot already contains it (default 168 = 7 days).
SYNC_RETENTION_HOURS=168

# Local PostgreSQL only. Replace these values for another local instance.
DATABASE_URL=postgres://syncpad:syncpad@127.0.0.1:5432/syncpad