# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3001/ws

# Backend
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Hours an update is kept after a snapshot already contains it (default 168 = 7 days).
SYNC_RETENTION_HOURS=168

# Sync limits (all optional; defaults shown). A limit that fires is logged as a JSON "sync limit hit" line.
# SYNC_HEARTBEAT_MS=30000
# SYNC_MESSAGES_PER_SECOND=100
# SYNC_MESSAGE_BURST=200
# SYNC_AWARENESS_PER_SECOND=20
# SYNC_MAX_MESSAGE_BYTES=1048576
# SYNC_MAX_NOTE_CHARS=500000
# SYNC_MAX_CLIENTS_PER_ROOM=50

# Local PostgreSQL only. Replace these values for another local instance.
DATABASE_URL=postgres://syncpad:syncpad@127.0.0.1:5432/syncpad