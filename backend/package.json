{
  "name": "syncpad-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 --test-timeout=60000 integration/*.int.test.ts",
    "smoke:journey": "tsx smoke/journey.ts",
    "bench": "tsx bench/run.mts"
  },
  "dependencies": {
    "@syncpad/shared": "file:../shared",
    "pg": "^8.16.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
